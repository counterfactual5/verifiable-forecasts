diff --git a/Makefile b/Makefile
index c4fda9e..f05facb 100644
--- a/Makefile
+++ b/Makefile
@@ -1,6 +1,6 @@
-.PHONY: verify test check fmt analysis analysis-sync
+.PHONY: verify test check fmt analysis analysis-sync agents agents-sync
 
-# After `make analysis-sync`, analysis checks run from uv.lock without network access
+# After `make analysis-sync` / `make agents-sync`, subproject checks run from uv.lock without network access
 export UV_LOCKED := 1
 export UV_OFFLINE := 1
 
@@ -9,6 +9,8 @@ verify:
 	cd contracts && forge fmt --check && forge build && forge test
 	cd analysis && uv run ruff check src tests
 	cd analysis && uv run pytest tests/ -q
+	cd agents && uv run ruff check src tests scripts
+	cd agents && uv run pytest tests/ -q
 
 test:
 	cd contracts && forge test
@@ -24,3 +26,10 @@ analysis:
 
 analysis-sync:
 	cd analysis && env -u UV_OFFLINE uv sync --locked
+
+agents:
+	cd agents && uv run ruff check src tests scripts
+	cd agents && uv run pytest tests/ -q
+
+agents-sync:
+	cd agents && env -u UV_OFFLINE uv sync --locked
