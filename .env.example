# Copy to .env (git-ignored) for demo/run.sh and demo/live.sh. Never commit real keys.
# Ethereum mainnet JSON-RPC used only as the anvil fork source; defaults to the public tenderly
# gateway when unset. A private endpoint (Alchemy, Infura, Tenderly with key) forks faster.
MAINNET_RPC_URL=
# Optional: pin the fork block (re-runs then hit anvil's on-disk fork cache). Must be a block in
# which the Chainlink ETH/USD feed updated, or settle voids the round for a stale feed.
FORK_BLOCK=
# Time-series model agents (agents/vol_agents/api_agent.py, api_agent.tsfm_agents): one agent per
# model, forecasting through your own self-hosted inference service (request/response format in
# agents/README.md). Unset VOL_TSFM_API_URL: the replay runs the zk agents only.
VOL_TSFM_API_URL=https://your-inference-host/v1
VOL_TSFM_API_KEY=
# Optional: send the key raw under this header instead of "Authorization: Bearer <key>".
VOL_TSFM_API_KEY_HEADER=
# Seconds per inference request (code default 30; 512-point contexts need longer).
VOL_TSFM_TIMEOUT_S=120
# Optional: comma-separated models, default timesfm-3.0,timestral-209m,chronos-2.
VOL_TSFM_MODELS=
# Optional long context for timestral-209m and chronos-2 (agents/vol_agents/history.py): a swap
# cache written by analysis/src/fetch_swaps.py. Unset or stale: the 16 onchain points are used.
# demo/live.sh sets both itself.
VOL_HISTORY_CACHE=
VOL_HISTORY_CONTEXT=512
# Optional: Python interpreter with torch and the models' runtimes (agents/README.md). When set, the
# replay recomputes every reproducible reveal with `python -m vol_agents.tsfm_recompute`;
# VOL_REPRO_PYTHON_<MODEL> (e.g. VOL_REPRO_PYTHON_TIMESFM_3_0) overrides it per model.
VOL_REPRO_PYTHON=
