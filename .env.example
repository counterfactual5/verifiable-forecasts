# Copy to .env (git-ignored) for demo/run.sh. Never commit real keys.
# Ethereum mainnet JSON-RPC used only as the anvil fork source; defaults to the public tenderly
# gateway when unset. A private endpoint (Alchemy, Infura, Tenderly with key) forks faster.
MAINNET_RPC_URL=
# Optional: pin the fork block (re-runs then hit anvil's on-disk fork cache). Must be a block in
# which the Chainlink ETH/USD feed updated, or settle voids the round for a stale feed.
FORK_BLOCK=
# Required by the replay (demo/run.sh): Python interpreter with chronos-forecasting and torch that
# runs the reproducible agent (agents/vol_agents/repro_runner.py) and its per-round recompute. The
# pinned amazon/chronos-bolt-tiny snapshot must already be in the Hugging Face cache; see
# agents/README.md "Reproducible agent". Missing interpreter or weights stop the replay, no fallback.
# An exported VOL_REPRO_PYTHON in the environment takes precedence over this file.
VOL_REPRO_PYTHON=
# Optional third-party time-series forecasting API for the commit-only API agent (agents/vol_agents/
# api_agent.py; request/response format in agents/README.md). Not used by the replay. Unset: a
# deterministic local placeholder forecast is used. Never commit a real key.
VOL_TSFM_API_URL=
VOL_TSFM_API_KEY=
# Optional: send the key raw under this header instead of "Authorization: Bearer <key>".
VOL_TSFM_API_KEY_HEADER=
VOL_TSFM_TIMEOUT_S=
