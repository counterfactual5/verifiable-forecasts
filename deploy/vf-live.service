# One live replay (demo/live.sh). The memory limits push this job into swap (an EZKL prove peaks
# near 1.2 GB) to keep the host responsive.
[Unit]
Description=verifiable-forecasts live replay on a mainnet fork
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/verifiable-forecasts
Environment=PATH=/root/.foundry/bin:/usr/local/bin:/usr/bin:/bin
# EZKL panics when HOME is unset, which it is under systemd.
Environment=HOME=/root
# Each round also swaps on a fork-local Uniswap v4 pool behind VolFeeHook (demo/v4_hook.py).
Environment=V4_HOOK=1
ExecStart=/bin/bash /opt/verifiable-forecasts/demo/live.sh
Nice=10
IOSchedulingClass=idle
CPUQuota=150%
MemoryHigh=900M
MemoryMax=1536M
TimeoutStartSec=55min
